# ─── Agente de IA (Gemini + Google Search grounding) ───────────────
# Sem esta chave o app roda em MODO DEMO (leads fictícios).
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Google Sheets API oficial (Service Account) ───────────────────
# Compartilhe a planilha com o e-mail da Service Account como Editor.
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave com \n literais, entre aspas:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
